# 실제 값은 .env(또는 Modal 비밀값 `chefear`)에만 적고 커밋하지 마세요. 이 파일은 필요한 키 목록만 공유합니다.
#
# 이 프로젝트는 서비스 실행 경로에서 외부 LLM API(OpenAI/Anthropic/Gemini/Groq 등)를 호출하지 않습니다
# (AGENTS.md 절대 원칙). 그래서 그런 키는 필요 없고 아래 목록에도 없습니다.
#
# 웹(web/)의 변수는 web/.env.example 에 따로 있습니다(VITE_* 는 브라우저 번들에 들어가므로 공개돼도 되는 값만).

# ── Supabase ───────────────────────────────────────────────────────────────
# 레시피 DB·대화 세션·음성 파일·로그인. 비우면 개발용 인메모리 mock DB로 동작합니다(실제 데이터는 안 보임).
# SUPABASE_URL=
# SUPABASE_KEY=        # 서버 전용 service_role(또는 sb_secret) 키. 웹·저장소에 절대 넣지 않는다.
# SUPABASE_ANON_KEY=   # 공개(anon/publishable) 키. 로그인 토큰 확인용 apikey. 비면 SUPABASE_KEY를 쓴다.

# ── 모델(Hugging Face, private 저장소) ─────────────────────────────────────
# HF_TOKEN=
# HF_STT_CT2_REPO=kimseunguk/chefear-stt-ct2-int8
# HF_TTS_MODEL_REPO=kimseunguk/qwen3-tts-kss-finetuned   # 선택, 기본값 동일

# ── API 서버(server/chefear_api) ───────────────────────────────────────────
# INFERENCE_BACKEND=modal          # modal(운영, Modal SDK로 STT/TTS 호출) | http | none
# MODAL_APP_NAME=chefear
# ALLOWED_ORIGINS=https://chefear.vercel.app   # CORS 허용 웹 주소, 쉼표로 여러 개. 기본 *
# REGISTER_DAILY_LIMIT=5           # 사용자당 하루 레시피 등록 수
# STT_RATE_PER_MIN=30              # IP당 분당 대화 요청
# TTS_RATE_PER_MIN=20              # IP당 분당 실시간 합성 요청
# MAX_AUDIO_BYTES=2000000          # 음성 업로드 최대 크기
# STT_VAD_FILTER=0                 # 1이면 STT 안에서도 무음 제거(브라우저가 이미 잘라 보내므로 기본 끔)
# ALLOW_DEV_USER=                  # 1이면 x-dev-user 헤더를 로그인으로 취급. 로컬 테스트 전용 — 운영에서는 절대 켜지 않는다.

# ── Modal 배포 때만(비밀값 아님, 배포를 실행하는 셸의 환경변수) ────────────
# CHEFEAR_STT_GPU=L4               # STT GPU 종류. 실측(results/stt/bench_modal.json)상 CPU는 발화당 8~11초라 GPU 사용
# CHEFEAR_TTS_GPU=L4
